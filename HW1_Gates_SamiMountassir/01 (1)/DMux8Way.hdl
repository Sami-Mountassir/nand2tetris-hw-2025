// File name: projects/1/DMux8Way.hdl
/**
 * 8-way demultiplexor:
 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 */
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    DMux(in=in, sel=sel[0], a=x0, b=x1);
    DMux(in=in, sel=sel[0], a=x2, b=x3);
    DMux(in=in, sel=sel[0], a=x4, b=x5);
    DMux(in=in, sel=sel[0], a=x6, b=x7);

    Not(in=sel[1], out=nsel1);
    Not(in=sel[2], out=nsel2);

    And(a=x0, b=nsel2, out=t0);
    And(a=x1, b=nsel2, out=t1);
    And(a=x2, b=nsel2, out=t2);
    And(a=x3, b=nsel2, out=t3);

    And(a=x4, b=sel[2], out=t4);
    And(a=x5, b=sel[2], out=t5);
    And(a=x6, b=sel[2], out=t6);
    And(a=x7, b=sel[2], out=t7);

    And(a=t0, b=nsel1, out=a);
    And(a=t1, b=nsel1, out=b);
    And(a=t2, b=sel[1], out=c);
    And(a=t3, b=sel[1], out=d);

    And(a=t4, b=nsel1, out=e);
    And(a=t5, b=nsel1, out=f);
    And(a=t6, b=sel[1], out=g);
    And(a=t7, b=sel[1], out=h);
}